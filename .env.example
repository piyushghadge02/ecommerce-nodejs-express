# Copy to .env and adjust for your machine. Never commit .env.

# --- PostgreSQL (authoritative orders/users) ---
# node-postgres uses a plain postgresql:// URL (the SQLAlchemy-style
# postgresql+asyncpg:// prefix is also accepted and normalized).
POSTGRES_DSN=postgresql://ecom:ecom@localhost:5432/ecommerce

# --- MongoDB (product catalog) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ecommerce

# --- Elasticsearch (order search index) ---
ELASTICSEARCH_URL=http://localhost:9200
ES_INDEX=orders

# --- Order -> Elasticsearch sync strategy: dual_write | outbox | polling ---
SYNC_STRATEGY=dual_write
OUTBOX_POLL_SECONDS=2
POLLING_INTERVAL_SECONDS=15
OUTBOX_MAX_ATTEMPTS=10

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend (Vue/Vite, shared build) ---
VITE_API_URL=http://localhost:8000
